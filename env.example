# ============================================================
# Cinematic Rail PoC — Environment Variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored and never committed.
# ============================================================


# ── Node / Next.js ───────────────────────────────────────────
NODE_ENV=production


# ── Frontend — BUILD-TIME variables ──────────────────────────
# These are baked into the Next.js JS bundle at `docker compose
# up --build` time.  Changing them requires a full image rebuild.
#
# NEXT_PUBLIC_API_URL
#   URL the browser uses to reach the FastAPI backend.
#   For local Docker: http://localhost:5000
#   For production:   https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
#   Mapbox GL JS public token.  Safe to expose in the bundle
#   (Mapbox tokens are scoped by URL allowlist in your account).
#   Get yours at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here


# ── Backend — RUNTIME secrets ────────────────────────────────
# These are injected into the FastAPI container at start time
# and are NEVER baked into any image layer.
#
# DATA_API_KEY
#   API key for the external trade/logistics data source.
#   Leave blank if the backend currently uses its built-in
#   static dataset (the PoC default).
DATA_API_KEY=

# PORT (optional — defaults are set in docker-compose.yml)
# PORT=5000
