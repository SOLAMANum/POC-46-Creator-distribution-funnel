<file path="docker-compose.yml">
# ============================================================
# POC 46 Creator Distribution Funnel — Docker Compose Stack
# Usage:
#   cp .env.example .env       # fill in your real values
#   docker compose up --build  # spin up both services
# ============================================================

services:

  # ──────────────────────────────────────────────
  # FastAPI Backend  →  http://localhost:5000
  # ──────────────────────────────────────────────
  backend:
    build:
      context: .
      dockerfile: Dockerfile
      target: backend-runner
    container_name: poc46-backend
    ports:
      - "5000:5000"
    env_file:
      - .env
    environment:
      - PORT=5000
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/data')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  # ──────────────────────────────────────────────
  # Next.js Frontend  →  http://localhost:3000
  # NOTE: NEXT_PUBLIC_* vars are baked into the
  # bundle at BUILD TIME — update args & rebuild
  # if you change the backend URL.
  # ──────────────────────────────────────────────
  frontend:
    build:
      context: .
      dockerfile: Dockerfile
      target: frontend-runner
      args:
        # These build args inject NEXT_PUBLIC_ values into the JS bundle
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:5000}
        NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN: ${NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN:-}
    container_name: poc46-frontend
    ports:
      - "3000:3000"
    env_file:
      - .env
    depends_on:
      backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
</file>

<file path="Dockerfile">
# ============================================================
# POC 46 Creator Distribution Funnel — Multi-Stage Dockerfile
# Services: Next.js Frontend (port 3000) + FastAPI Backend (port 5000)
# ============================================================

# ─────────────────────────────────────────────────────────────
# STAGE 1 — frontend-deps
# Install Node dependencies (cached layer, only rebuilt on lockfile change)
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS frontend-deps
RUN apk add --no-cache libc6-compat
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# ─────────────────────────────────────────────────────────────
# STAGE 2 — frontend-builder
# Compile Next.js production assets with build-time env injection.
# NEXT_PUBLIC_* variables are baked into the static bundle at build time.
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY --from=frontend-deps /app/frontend/node_modules ./node_modules
COPY frontend/ .

# Accept build-time variables from docker-compose args
ARG NEXT_PUBLIC_API_URL=http://localhost:5000
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=$NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ─────────────────────────────────────────────────────────────
# STAGE 3 — frontend-runner
# Minimal production image using Next.js standalone output.
# Runs as a non-root system user for security.
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS frontend-runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Create a locked-down system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Copy standalone output and static assets from builder
COPY --from=frontend-builder /app/frontend/public                        ./public
COPY --from=frontend-builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=frontend-builder --chown=nextjs:nodejs /app/frontend/.next/static     ./.next/static

USER nextjs
EXPOSE 3000

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]

# ─────────────────────────────────────────────────────────────
# STAGE 4 — backend-runner
# FastAPI served via Uvicorn. Runs as a slim Python 3.12 image.
# ─────────────────────────────────────────────────────────────
FROM python:3.12-slim AS backend-runner
WORKDIR /app/backend

# Suppress .pyc files and force unbuffered logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install dependencies first (cached layer)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend application
COPY backend/ .

EXPOSE 5000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
</file>

